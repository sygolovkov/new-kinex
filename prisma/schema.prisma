generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Единственная запись настроек приложения (singleton, id = 1)
model Settings {
  id                      Int       @id @default(1)
  adminTelegramUsername   String    @default("") @map("admin_telegram_username")
  botToken                String    @default("") @map("bot_token")
  paymentSystemCommission Decimal   @default("5.00") @map("payment_system_commission") @db.Decimal(5, 2)
  lastUsdtRate            Decimal?  @map("last_usdt_rate") @db.Decimal(10, 4)
  lastUsdtRateAt          DateTime? @map("last_usdt_rate_at")
  withdrawalLimit         Decimal   @default("400000.00") @map("withdrawal_limit") @db.Decimal(12, 2)

  @@map("settings")
}

/// Администратор панели управления (аналог Django-суперюзера)
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}

enum ProfileChangeField {
  email
  usdt_wallet
}

enum ProfileChangeStatus {
  PENDING
  COMPLETED
}

enum PaymentStatus {
  CREATED // 0
  IN_PROCESS // 1
  SUCCESS // 2
  ERROR // 6
  SERVER_ERROR // -6
}

enum WithdrawalStatus {
  PENDING
  COMPLETED
}

model Manager {
  id               String   @id @default(cuid())
  telegramId       String   @default("") @map("telegram_id")
  telegramUsername String   @default("") @map("telegram_username")
  name             String   @default("")
  email            String   @default("")
  usdtWallet       String   @default("") @map("usdt_wallet")
  commission       Decimal  @default("5.00") @db.Decimal(5, 2)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  changeRequests ProfileChangeRequest[]
  payments       Payment[]
  withdrawals    Withdrawal[]

  @@map("managers")
}

model ProfileChangeRequest {
  id        String              @id @default(cuid())
  managerId String              @map("manager_id")
  manager   Manager             @relation(fields: [managerId], references: [id], onDelete: Cascade)
  field     ProfileChangeField
  newValue  String              @map("new_value")
  status    ProfileChangeStatus @default(PENDING)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@index([managerId])
  @@map("profile_change_requests")
}

model Payment {
  id            String        @id @default(cuid())
  managerId     String?       @map("manager_id")
  manager       Manager?      @relation(fields: [managerId], references: [id], onDelete: Restrict)
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("RUB")
  orderId       String        @unique @map("order_id")
  description   String        @default("")
  transactionId String        @default("") @map("transaction_id")
  status        PaymentStatus @default(CREATED)
  isSettled     Boolean       @default(false) @map("is_settled")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([isSettled])
  @@index([managerId])
  @@map("payments")
}

model Withdrawal {
  id         String           @id @default(cuid())
  managerId  String           @map("manager_id")
  manager    Manager          @relation(fields: [managerId], references: [id], onDelete: Restrict)
  amount     Decimal          @db.Decimal(12, 2)
  usdtAmount Decimal?         @map("usdt_amount") @db.Decimal(12, 2)
  usdtRate   Decimal?         @map("usdt_rate") @db.Decimal(10, 4)
  status     WithdrawalStatus @default(PENDING)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@index([managerId])
  @@map("withdrawals")
}

/// Состояние FSM-диалога Telegram-бота для режима webhook (заменяет aiogram FSMContext в памяти)
model BotDialogState {
  chatId    String   @id @map("chat_id")
  state     String?
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("bot_dialog_states")
}
